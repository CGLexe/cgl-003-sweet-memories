{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "User-Agent" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "Vary", "value": "User-Agent" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/movil/index.html", "has": [{ "type": "query", "key": "v", "value": "movil" }] },
    { "source": "/:path*", "destination": "/movil/:path*", "has": [{ "type": "query", "key": "v", "value": "movil" }] },
    { "source": "/", "destination": "/web/index.html", "has": [{ "type": "query", "key": "v", "value": "web" }] },
    { "source": "/:path*", "destination": "/web/:path*", "has": [{ "type": "query", "key": "v", "value": "web" }] },
    {
      "source": "/",
      "destination": "/movil/index.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(android|iphone|ipad|ipod|mobile|windows phone|blackberry|opera mini|iemobile).*" }
      ]
    },
    {
      "source": "/:path*",
      "destination": "/movil/:path*",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(android|iphone|ipad|ipod|mobile|windows phone|blackberry|opera mini|iemobile).*" }
      ]
    },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/:path*", "destination": "/web/:path*" }
  ]
}
